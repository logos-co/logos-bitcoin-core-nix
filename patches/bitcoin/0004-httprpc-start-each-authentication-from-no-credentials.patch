From b5db8c85f7e0ea8145527140d5bd7dadcb987fd3 Mon Sep 17 00:00:00 2001
From: Dario Gabriel Lipicar <dario@status.im>
Date: Sat, 10 Oct 2026 20:07:19 -0300
Subject: [PATCH 4/4] httprpc: start each RPC authentication from no
 credentials

InitRPCAuthentication() only appends to g_rpcauth and intersects into
g_rpc_whitelist. In a process that starts the server a second time, the
first run's cookie would still be accepted and its whitelists would
narrow the new ones.
---
 src/httprpc.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/httprpc.cpp b/src/httprpc.cpp
index 56a2430..d4da126 100644
--- a/src/httprpc.cpp
+++ b/src/httprpc.cpp
@@ -239,6 +239,10 @@ static bool HTTPReq_JSONRPC(const std::any& context, HTTPRequest* req)
 
 static bool InitRPCAuthentication()
 {
+    // An earlier start's credentials and whitelists would otherwise still be accepted.
+    g_rpcauth.clear();
+    g_rpc_whitelist.clear();
+
     std::string user;
     std::string pass;
 
